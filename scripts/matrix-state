#!/bin/zsh
# matrix-state hook                          (Claude Code hook, reads the event JSON on stdin)
# matrix-state working|idle|reset [/dev/ttysNNN [raw]]   (manual)
# matrix-state sweep                         (every few seconds from a LaunchAgent, see below)
#
# Tells the shader whether Claude is working in this window (rain shows through) or waiting for you
# (calm), by setting an almost invisible background tint with OSC 11.
# "Working" also covers subagents that are still running after Claude's turn ended, so a window only
# turns calm when everything in it is done, or when Claude asks you something. Background shells
# (dev servers, wait loops) count only for their first SHELL_MIN minutes, a server would never end.
# Some endings have no hook at all (Esc, Claude quit or crashed, a background task finishing), so
# `sweep` re-checks every window that is still marked working and calms it down.
SHELL_MIN=15
[[ -s "$HOME/.config/ghostty/matrix-mode.conf" || "$1" == reset ]] || { [[ "$1" == hook ]] && cat >/dev/null; exit 0; }
CACHE="$HOME/.cache/matrix-mode"

# working or idle for one session folder, from the marker files the hook keeps there
compute() {   # $1 = session dir
  local d="$1" running shells
  [[ -f "$d/block" ]] && { echo idle; return; }
  [[ -f "$d/main" ]] && { echo working; return; }
  running=$(find "$d/agents" -type f -mmin -360 2>/dev/null | wc -l)          # an agent can sit in one long command for a while
  shells=$(find "$d/shells" -type f -mmin -$SHELL_MIN 2>/dev/null | wc -l)
  (( running > 0 || shells > 0 )) && echo working || echo idle
}

if [[ "$1" == sweep ]]; then
  for d in "$CACHE"/*(N/); do
    [[ -s "$d/tty" && -f "$d/state" ]] || continue
    tty=$(<"$d/tty"); [[ -w "$tty" ]] || { rm -f "$d/tty"; continue; }
    # Claude gone from that terminal (quit, crashed, window reused) → nothing works there any more
    if ! ps -t "${tty#/dev/}" -o comm= 2>/dev/null | grep -qi claude; then
      rm -rf "$d/main" "$d/block" "$d/agents" "$d/shells"
    elif [[ -f "$d/main" ]]; then
      # Esc, an API error or a cancelled prompt fire no hook. Claude Code itself keeps busy/idle in
      # ~/.claude/sessions/<pid>.json, that is the truth; older versions: the transcript then ends
      # with "[Request interrupted by user…]"
      /usr/bin/python3 - "${d:t}" "$(<"$d/transcript" 2>/dev/null)" "$d/main" <<'EOF' && rm -f "$d/main"
import glob, json, os, sys, time
sid, tr, main = sys.argv[1], sys.argv[2], sys.argv[3]
for p in glob.glob(os.path.expanduser('~/.claude/sessions/*.json')):
    try:
        s = json.load(open(p))
        if s.get('sessionId') != sid: continue
        os.kill(s['pid'], 0)
    except Exception: continue
    if s.get('status') in ('busy', 'idle'):
        quiet = time.time() * 1000 - s.get('statusUpdatedAt', 0) > 5000   # not the moment a prompt was sent
        sys.exit(0 if s['status'] == 'idle' and quiet and time.time() - os.path.getmtime(main) > 5 else 1)
try:
    with open(tr, 'rb') as f:
        f.seek(0, 2); f.seek(max(0, f.tell() - 400000)); lines = f.read().decode('utf-8', 'ignore').splitlines()
except Exception: sys.exit(1)
for l in reversed(lines):
    try: e = json.loads(l)
    except Exception: continue
    if e.get('type') not in ('user', 'assistant') or e.get('isSidechain'): continue
    c = (e.get('message') or {}).get('content')
    t = c if isinstance(c, str) else ' '.join(x.get('text', '') for x in c or [] if isinstance(x, dict))
    sys.exit(0 if e['type'] == 'user' and t.startswith('[Request interrupted by user') else 1)
sys.exit(1)
EOF
    fi
    mkdir -p "$d/agents"
    new=$(compute "$d")
    [[ "$new" == "$(<"$d/state")" ]] && continue
    echo "$new" > "$d/state"
    "$0" "$new" "$tty"
  done
  exit 0
fi

state="$1"; tty="$2"
if [[ "$1" == hook ]]; then
  input="$(cat)"
  # top-level fields only: event, session, agent/task id, notification type, background tasks yes/no
  # top-level fields, plus the ids of background tasks still running: shells apart from agents/workflows
  IFS=$'\t' read -r event session aid tid ntype transcript bgshells bgagents <<< "$(printf '%s' "$input" | /usr/bin/python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: d = {}
s = lambda k: d.get(k) if isinstance(d.get(k), str) and d.get(k) else "-"
bt = [t for t in d.get("background_tasks") or [] if isinstance(t, dict) and t.get("status", "running") == "running"]
ids = lambda shell: ",".join(str(t.get("id")) for t in bt if (t.get("type") in ("shell", "monitor")) == shell) or "-"
print("\t".join([s("hook_event_name"), s("session_id"), s("agent_id"), s("task_id"),
                 s("notification_type"), s("transcript_path").replace("\t", " "), ids(True), ids(False)]))' 2>/dev/null)"
  session="${session//[^A-Za-z0-9_-]/}"; aid="${aid//[^A-Za-z0-9_-]/}"; tid="${tid//[^A-Za-z0-9_-]/}"
  bgshells="${bgshells//[^A-Za-z0-9_,-]/}"; bgagents="${bgagents//[^A-Za-z0-9_,-]/}"
  [[ -n "$session" && "$session" != - ]] || session=nosession
  dir="$CACHE/$session"
  mkdir -p "$dir/agents" "$dir/shells"
  [[ "$transcript" == /* ]] && print -r -- "$transcript" > "$dir/transcript"
  case "$event" in
    SessionStart)                   rm -rf "$dir/main" "$dir/block" "$dir/agents" "$dir/shells"; mkdir -p "$dir/agents" "$dir/shells" ;;
    UserPromptSubmit|PreToolUse)
      # tool calls of subagents arrive in the same session but carry agent_id: count them as the agent,
      # not as Claude's own turn (otherwise the window stays "working" after the agent is gone)
      if [[ "$aid" != - && -n "$aid" ]]; then : > "$dir/agents/$aid"
      else rm -f "$dir/block"; : > "$dir/main"; fi ;;
    SubagentStart)                  [[ -n "$aid" && "$aid" != - ]] && : > "$dir/agents/$aid" ;;
    SubagentStop)                   [[ -n "$aid" && "$aid" != - ]] && rm -f "$dir/agents/$aid" ;;
    TaskCreated)                    [[ -n "$tid" && "$tid" != - ]] && : > "$dir/agents/task-$tid" ;;
    TaskCompleted)                  [[ -n "$tid" && "$tid" != - ]] && rm -f "$dir/agents/task-$tid" ;;
    Notification)
      case "$ntype" in
        idle_prompt|auth_*) ;;                                     # not a question, keep the state
        elicitation_complete|elicitation_response) rm -f "$dir/block" ;;
        *) : > "$dir/block" ;;                                     # permission prompt, question → your turn
      esac ;;
    Stop)
      # the list of running background tasks is the truth: drop markers of anything no longer in it
      rm -f "$dir/main" "$dir/block" "$dir/bg"
      find "$dir/agents" -mindepth 1 -delete 2>/dev/null
      for i in ${(s:,:)bgagents}; do [[ "$i" != - ]] && : > "$dir/agents/$i"; done
      for f in "$dir"/shells/*(N); do [[ ",$bgshells," == *",${f:t},"* ]] || rm -f "$f"; done
      for i in ${(s:,:)bgshells}; do [[ "$i" != - && ! -e "$dir/shells/$i" ]] && : > "$dir/shells/$i"; done ;;   # keep the start time
  esac
  # waiting for you beats everything; otherwise working while anything at all still runs
  state=$(compute "$dir")
  echo "$state" > "$dir/state"
  find "$CACHE" -mindepth 1 -maxdepth 1 -type d -mtime +2 -exec rm -rf {} + 2>/dev/null
fi

case "$state" in
  working) seq=$'\e]11;#040b04\a' ;;   # keep these two in sync with shaders/matrix.glsl
  idle)    seq=$'\e]11;#000402\a' ;;
  reset)   seq=$'\e]111\a' ;;
  *) exit 0 ;;
esac
if [[ -z "$tty" ]]; then
  if [[ -n "$TMUX_PANE" ]]; then
    tty=$(tmux display -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null)
  else
    # hooks have no controlling tty, walk up to the Claude process that owns one
    pid=$PPID
    for _ in {1..10}; do
      t=$(ps -o tty= -p $pid 2>/dev/null | tr -d ' ')
      [[ "$t" == ttys* ]] && { tty="/dev/$t"; break; }
      pid=$(ps -o ppid= -p $pid 2>/dev/null | tr -d ' ')
      [[ -z "$pid" || "$pid" -le 1 ]] && break
    done
  fi
fi
[[ "$tty" == /dev/tty* && -w "$tty" ]] || exit 0
if [[ "$1" == hook ]] && [[ "$(cat "$dir/tty" 2>/dev/null)" != "$tty" ]]; then
  grep -lx "$tty" "$CACHE"/*/tty(N) 2>/dev/null | xargs rm -f   # one session per terminal: the latest one
  print -r -- "$tty" > "$dir/tty"
fi
# "raw": the tty belongs directly to a Ghostty window, write without tmux wrapping or checks
if [[ "$3" == raw ]]; then printf '%s' "$seq" > "$tty" 2>/dev/null; exit 0; fi

# Only Ghostty windows on this Mac, never Claude sessions reached over ssh from elsewhere
in_ghostty() {   # does the parent chain of the process on terminal $1 lead to Ghostty?
  local pid=$(ps -t "${1#/dev/}" -o pid= 2>/dev/null | head -1 | tr -d ' ')
  while [[ -n "$pid" && "$pid" -gt 1 ]]; do
    [[ "$(ps -o comm= -p $pid)" == *Ghostty.app* ]] && return 0
    pid=$(ps -o ppid= -p $pid | tr -d ' ')
  done
  return 1
}
in_tmux=0
if tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | grep -qx "$tty"; then
  in_tmux=1
  ses=$(tmux list-panes -a -F '#{pane_tty} #{session_name}' | awk -v t="$tty" '$1==t {print $2; exit}')
  ok=1
  for c in $(tmux list-clients -t "$ses" -F '#{client_tty}' 2>/dev/null); do in_ghostty "$c" && ok=0; done
  (( ok == 0 )) || exit 0
else
  in_ghostty "$tty" || exit 0
fi
if (( in_tmux )); then
  # inside tmux the sequence has to be wrapped or tmux swallows it (needs allow-passthrough on)
  printf '\ePtmux;%s\e\\' "${seq//$'\e'/$'\e\e'}" > "$tty" 2>/dev/null
else
  printf '%s' "$seq" > "$tty" 2>/dev/null
fi
exit 0
